# Google Sheets & Service Account Configuration
PORT=3001

# Spreadsheet ID from URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=your_spreadsheet_id_here

# Tab sheet name (e.g., Sheet1)
SHEET_NAME=Sheet1

# Google Service Account Email (from Google Cloud Console IAM > Service Accounts)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Private key from Service Account JSON file (keep the quotes and \n intact)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# กล่องจดหมายที่ workflow 02 อ่าน ใช้เปิดไฟล์แนบจากอีเมลด้วย Message-ID (Gmail: ต้องเปิด 2-Step Verification แล้วสร้าง App Password)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-mailbox@example.com
IMAP_PASSWORD=your_app_password
