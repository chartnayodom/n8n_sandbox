N8N_PORT=5678
N8N_PROTOCOL=http
N8N_HOST=localhost
GENERIC_TIMEZONE=Asia/Bangkok
TZ=Asia/Bangkok
# Generate a random string and keep it constant across deployments so credentials remain decryptable
N8N_ENCRYPTION_KEY=replace_with_a_strong_32_character_secret_key

# URL ที่ภายนอกใช้เรียก n8n (ใช้สร้าง production URL ของ webhook เช่น https://n8n.example.com/)
WEBHOOK_URL=http://localhost:5678/
# พอร์ตของเว็บจัดการระบบ (service web ใน docker-compose.yml)
WEB_PORT=5000
