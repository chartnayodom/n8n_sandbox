              "id": "55a1ba70-c0da-4578-bc13-5b42ebabd98e",
              "leftValue": "={{ $json.skip === true }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
