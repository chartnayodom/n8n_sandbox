      "id": "924e16b8-9372-416a-9bc8-15e486d0f168",
      "name": "Upload to Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        1680,
        540
      ],
      "onError": "continueRegularOutput",
      "notes": "ต้องใช้ credential Google Drive OAuth2 ของบัญชีผู้ใช้ (Service Account ไม่มีพื้นที่ อัปโหลดไม่ได้) และแชร์โฟลเดอร์ให้อีเมล Service Account อ่านได้ เพื่อให้เว็บแสดงไฟล์",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "// รวมผลอัปโหลดไฟล์แนบกลับเข้าอีเมลแต่ละฉบับ (ผูกด้วย log_id) แล้วส่งอีเมลต่อพร้อม binary เดิม (ใช้แนบตอน forward)\n// attachments = JSON [{ id, name, mimeType, size }] เก็บลงคอลัมน์ Attachments ของ Email_Logs ให้เว็บแสดงตัวอย่างไฟล์ได้\nconst tryAll = name => { try { return $(name).all(); } catch (e) { return []; } }; // node ที่ไม่ได้ทำงานในรอบนี้\nconst splits = tryAll('Split Attachments');\nconst uploads = tryAll('Upload to Drive');\n\nconst saved = {};\nconst failed = {};\nuploads.forEach((u, i) => {\n  const s = splits[u.pairedItem?.item ?? i]?.json;\n  if (!s || s.skip) return;\n  if (u.json.id) (saved[s.log_id] ||= []).push({ id: u.json.id, name: s.file_name, mimeType: s.mime_type, size: s.size });\n  else (failed[s.log_id] ||= []).push(s.file_name);\n});\n\nreturn $('Route Inbound Mail').all().map(r => {\n  const j = r.json;\n  let note = '';\n  if (failed[j.log_id]) note = `บันทึกไฟล์แนบลง Google Drive ไม่สำเร็จ: ${failed[j.log_id].join(', ')}`;\n  else if (!j.folder_id && j.attach_names) note = 'ไม่ได้บันทึกไฟล์แนบ: ยังไม่ได้ตั้งค่าโฟลเดอร์ (config: attachment_folder_id)';\n  return {\n    json: { ...j, attachments: JSON.stringify(saved[j.log_id] || []), attachment_note: note },\n    binary: r.binary\n  };\n});"
      },
