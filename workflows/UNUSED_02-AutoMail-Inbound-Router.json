    {
      "parameters": {
        "jsCode": "// แยกอีเมลขาเข้าตาม Flow 2 (แผนภาพ Auto mail flowchart):\n//   ส่งต่อบริษัทประกัน = ผู้ส่งอยู่ใน Master_Data และ (เป็น Reply ของอีเมลที่ระบบส่ง หรือ หัวข้อมี prefix ตาม config: subject_prefixes)\n//     - ถ้าปิด Auto Forward = Pending (รอเจ้าหน้าที่ส่งต่อ), ถ้ายังไม่ตั้ง insurance_email = Failed\n//   นอกนั้นทั้งหมด = Needs Review (ผู้ส่งไม่อยู่ใน Master_Data, หรืออยู่แต่ไม่ใช่ Reply และหัวข้อไม่มี prefix)\n//   ข้าม: ผู้ส่งอยู่ในรายการละเว้น / เป็นบริษัทประกัน / เมลที่ Message-ID อยู่ใน Email_Logs แล้ว\nconst cfg = $('Global Config').first().json;\nconst csv = s => String(s || '').split(',').map(x => x.trim().toLowerCase()).filter(Boolean);\nconst clean = s => String(s || '').replace(/[<>]/g, '').trim();\nconst esc = s => String(s ?? '').replace(/[&<>\"]/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[ch]));\n\n// --- config sheet (Category = SYSTEM) ---\nconst sys = {};\nfor (const i of $('Read config').all()) {\n  const r = i.json;\n  if (String(r.Category || '').trim().toUpperCase() === 'SYSTEM') sys[String(r.Key || '').trim()] = String(r.Value || '').trim();\n}\nconst insuranceEmail = sys.insurance_email || '';\nconst autoForward = String(sys.auto_forward || 'TRUE').trim().toUpperCase() !== 'FALSE';\nconst prefixes = csv(sys.subject_prefixes);\nconst folderId = sys.attachment_folder_id || ''; // โฟลเดอร์ Google Drive เก็บไฟล์แนบ (ว่าง = ไม่เก็บ)\nconst testTo = String(cfg.test_forward_email || '').trim(); // ไม่ว่าง = โหมดทดสอบ forward ไปอีเมลนี้แทนบริษัทประกัน\nconst forwardTo = testTo || insuranceEmail;\n\nconst ignoreSenders = new Set(csv(cfg.ignore_senders));\nif (insuranceEmail) ignoreSenders.add(insuranceEmail.toLowerCase());\n\n// --- Master_Data / Email_Logs ---\nconst master = new Map();\nfor (const i of $('Read Master_Data').all()) {\n  const e = String(i.json.Email || '').trim().toLowerCase();\n  if (e) master.set(e, i.json);\n}\nconst logged = new Set();\nfor (const i of $('Read Email_Logs').all()) {\n  const id = clean(i.json.Message_ID);\n  if (id) logged.add(id);\n}\n\nconst results = [];\nfor (const item of $('Listener: IMAP Email Trigger').all()) {\n  const mail = item.json;\n  const from = mail.from?.value?.[0] || {};\n  const addr = String(from.address || '').trim().toLowerCase();\n  const subject = String(mail.subject || '').trim();\n  const lowerSubject = subject.toLowerCase();\n  const messageId = clean(mail.messageId || mail.headers?.['message-id']);\n\n  // Reply ของอีเมลที่ระบบเคยส่ง: In-Reply-To / References ตรงกับ Message_ID ใน Email_Logs\n  const refs = [].concat(mail.inReplyTo || mail.headers?.['in-reply-to'] || [], mail.references || mail.headers?.references || [])\n    .join(' ').split(/\\s+/).map(clean).filter(Boolean);\n  const isReply = refs.some(r => logged.has(r));\n  const matchedPrefix = prefixes.find(p => lowerSubject.includes(p));\n\n  // route: ignore | forward | review | hold   (hold = ผ่านเงื่อนไขส่งต่อ แต่ส่งต่อไม่ได้ในตอนนี้)\n  let route = 'ignore';\n  let reason = '';\n  let logStatus = '';\n  const row = master.get(addr);\n\n  if (!addr) reason = 'ไม่มีอีเมลผู้ส่ง';\n  else if (ignoreSenders.has(addr)) reason = 'ผู้ส่งอยู่ในรายการละเว้น';\n  else if (messageId && logged.has(messageId)) reason = 'ประมวลผลแล้ว';\n  else if (!row) {\n    route = 'review'; logStatus = 'Needs Review';\n    reason = isReply ? 'ตอบกลับอีเมลที่ระบบส่ง แต่ไม่พบอีเมลผู้ส่งใน Master Data' : 'ไม่พบอีเมลผู้ส่งใน Master Data';\n  } else if (!isReply && !matchedPrefix) {\n    route = 'review'; logStatus = 'Needs Review';\n    reason = prefixes.length\n      ? 'ผู้ส่งอยู่ใน Master Data แต่ไม่ใช่การตอบกลับ และหัวข้อไม่มี prefix ที่กำหนด'\n      : 'ผู้ส่งอยู่ใน Master Data แต่ยังไม่ได้ตั้งค่า prefix หัวข้อ (config: subject_prefixes)';\n  } else {\n    const via = isReply ? 'ตอบกลับอีเมลที่ระบบส่ง' : `หัวข้อมี prefix \"${matchedPrefix}\"`;\n    if (!autoForward) { route = 'hold'; logStatus = 'Pending'; reason = `${via} แต่ปิด Auto Forward รอเจ้าหน้าที่ส่งต่อ`; }\n    else if (!forwardTo) { route = 'hold'; logStatus = 'Failed'; reason = 'ยังไม่ได้ตั้งค่าอีเมลบริษัทประกัน (config: insurance_email)'; }\n    else { route = 'forward'; reason = `พบผู้ส่งใน Master Data และ${via}`; }\n  }\n  if (route === 'ignore') continue;\n\n  const binary = item.binary || {};\n  const attachNames = Object.keys(binary);\n  const bodyHtml = mail.html || `<pre style=\"white-space: pre-wrap; font-family: inherit;\">${esc(mail.text || '(ไม่มีข้อความ)')}</pre>`;\n  const customer = row\n    ? `<p style=\"margin: 2px 0;\"><strong>ลูกค้า:</strong> ${esc(row.Customer_Name)} (${esc(row.Insurance_Type || '-')})</p>\n       <p style=\"margin: 2px 0;\"><strong>เลขที่กรมธรรม์:</strong> ${esc(row.Policy_No || '-')} &nbsp; <strong>วันหมดอายุ:</strong> ${esc(row.Expiry_Date || '-')}</p>`\n    : '';\n  const forwardHtml = `\n<div style=\"font-family: Arial, sans-serif; font-size: 14px; line-height: 1.6; color: #222;\">\n  <div style=\"background-color: #e8f0fe; border-left: 4px solid #1a73e8; padding: 12px 16px; margin-bottom: 16px;\">\n    <strong>[AutoMail] ส่งต่ออัตโนมัติ</strong>${testTo ? ' <span style=\"color:#b45309;\">(โหมดทดสอบ)</span>' : ''}<br/>\n    <span style=\"font-size: 12px;\">${esc(reason)}</span>\n  </div>\n  <div style=\"background-color: #f8f9fa; border: 1px solid #ddd; padding: 12px 16px; margin-bottom: 16px; font-size: 13px;\">\n    ${customer}\n    <p style=\"margin: 2px 0;\"><strong>From:</strong> ${esc(mail.from?.text || addr)}</p>\n    <p style=\"margin: 2px 0;\"><strong>Date:</strong> ${esc(mail.date || '')}</p>\n    <p style=\"margin: 2px 0;\"><strong>Subject:</strong> ${esc(subject)}</p>\n    ${attachNames.length ? `<p style=\"margin: 2px 0;\"><strong>ไฟล์แนบ:</strong> ${attachNames.length} ไฟล์</p>` : ''}\n  </div>\n  <div>${bodyHtml}</div>\n</div>`;\n\n  results.push({\n    json: {\n      route,\n      reason,\n      log_status: logStatus,\n      log_round: route === 'review' ? 'Needs Review (อีเมลขาเข้า)' : 'อีเมลขาเข้า (ยังไม่ได้ส่งต่อ)',\n      test_mode: Boolean(testTo),\n      from_email: addr,\n      from_name: from.name || '',\n      subject,\n      message_id: messageId,\n      customer_id: row?.ID || '',\n      customer_name: row?.Customer_Name || from.name || addr,\n      forward_to: forwardTo,\n      forward_subject: (testTo ? '[TEST] ' : '') + (lowerSubject.startsWith('fwd:') ? subject : `Fwd: ${subject}`),\n      forward_html: forwardHtml,\n      attach_names: attachNames.join(', '),\n      // รายการไฟล์แนบ (ลำดับ ชื่อ ชนิด ขนาด) เก็บลง Email_Logs ให้เว็บเปิดไฟล์จากกล่องจดหมายด้วย Message-ID ตามลำดับนี้\n      attachments_meta: JSON.stringify(Object.values(binary).map((b, i) => ({ index: i, name: b.fileName || ('attachment_' + i), mimeType: b.mimeType || 'application/octet-stream', size: b.fileSize || '' }))),\n      folder_id: folderId,\n      log_id: `LOG-${Date.now()}-${Math.random().toString(36).slice(2, 7)}`,\n      // เก็บเนื้อหาไว้ใน Email_Logs (คอลัมน์ Original_Body) เพื่อให้ปุ่ม Re-forward ส่งซ้ำได้ (จำกัดความยาวของเซลล์ Google Sheets)\n      original_body: bodyHtml.slice(0, 40000),\n      review_alert_email: String(cfg.review_alert_email || '').trim()\n    },\n    binary\n  });\n}\nreturn results;"
      },
      "id": "956ad324-2e48-431a-8b90-8611e515d0b9",
      "name": "Route Inbound Mail",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// แยกไฟล์แนบของแต่ละอีเมลเป็น 1 item ต่อ 1 ไฟล์ เพื่ออัปโหลดเข้า Google Drive (โฟลเดอร์จาก config: attachment_folder_id)\n// ถ้าไม่มีไฟล์ต้องเก็บเลย ส่ง item { skip: true } ตัวเดียว เพื่อให้ flow ไปต่อที่ Collect Attachments โดยไม่ผ่านการอัปโหลด\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  if (!j.folder_id) continue;\n  for (const [key, bin] of Object.entries(item.binary || {})) {\n    const fileName = bin.fileName || key;\n    out.push({\n      json: {\n        log_id: j.log_id,\n        folder_id: j.folder_id,\n        file_name: fileName,\n        drive_name: `${j.log_id}_${fileName}`,\n        mime_type: bin.mimeType || 'application/octet-stream',\n        size: bin.fileSize || ''\n      },\n      binary: { data: bin }\n    });\n  }\n}\nreturn out.length ? out : [{ json: { skip: true } }];"
      },
      "id": "05c082f4-ec03-469a-8e94-4ff7a44f9cd4",
      "name": "Split Attachments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        420
      ],
      "notes": "สำรอง ไม่ได้เชื่อมต่อ: อัปโหลดไฟล์แนบเข้า Google Drive (ตอนนี้เว็บเปิดไฟล์จากกล่องจดหมายด้วย Message-ID แทน) ถ้าจะใช้: ต่อ Route Inbound Mail → Split Attachments และ Collect Attachments → Is Forward? แล้วเปลี่ยนการอ้างอิงใน node Log ทั้ง 3 เป็น Collect Attachments และคอลัมน์ Attachments เป็นค่า attachments",
      "notesInFlow": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
