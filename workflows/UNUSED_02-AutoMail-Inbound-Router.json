        "jsCode": "// Re-forward จากปุ่มบนเว็บ: เว็บส่ง { action: 're-forward', logId, ... } มาที่ webhook\n// ปลายทางอ่านจาก config (insurance_email) เสมอ ไม่ใช้ค่าที่มากับ request เพื่อกัน webhook ถูกเรียกให้ส่งเมลไปที่อื่น\n// (เว็บเป็นฝ่ายเพิ่มแถว log ของการ re-forward เอง workflow นี้จึงไม่เขียน Email_Logs ซ้ำ)\nconst cfg = $('Re-forward Config').first().json;\nconst esc = s => String(s ?? '').replace(/[&<>\"]/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[ch]));\nconst body = $('Webhook: Re-forward').first().json.body || {};\n\nif (body.action !== 're-forward' || !body.logId) throw new Error('คำขอไม่ถูกต้อง: ต้องมี action = re-forward และ logId');\n\nconst sys = {};\nfor (const i of $('Read config (Re-forward)').all()) {\n  const r = i.json;\n  if (String(r.Category || '').trim().toUpperCase() === 'SYSTEM') sys[String(r.Key || '').trim()] = String(r.Value || '').trim();\n}\nconst testTo = String(cfg.test_forward_email || '').trim();\nconst forwardTo = testTo || sys.insurance_email;\nif (!forwardTo) throw new Error('ยังไม่ได้ตั้งค่าอีเมลบริษัทประกัน (config: insurance_email)');\n\nconst row = $('Read Email_Logs (Re-forward)').all().map(i => i.json).find(r => String(r.Log_ID || '').trim() === String(body.logId).trim());\nif (!row) throw new Error(`ไม่พบรายการ ${body.logId} ใน Email_Logs`);\n\nconst original = String(row.Original_Body || '').trim();\nconst note = original\n  ? ''\n  : '<p style=\"color:#b45309;\">รายการนี้ไม่มีเนื้อหาต้นฉบับเก็บไว้ในระบบ (ส่งก่อนเริ่มเก็บเนื้อหา) กรุณาดูต้นฉบับจากกล่องจดหมาย</p>';\n\nconst subject = String(row.Subject || '');\nreturn [{\n  json: {\n    forward_to: forwardTo,\n    forward_subject: (testTo ? '[TEST] ' : '') + (subject.toLowerCase().startsWith('fwd:') ? subject : `Fwd: ${subject}`),\n    forward_html: `\n<div style=\"font-family: Arial, sans-serif; font-size: 14px; line-height: 1.6; color: #222;\">\n  <div style=\"background-color: #e8f0fe; border-left: 4px solid #1a73e8; padding: 12px 16px; margin-bottom: 16px;\">\n    <strong>[AutoMail] ส่งต่ออีกครั้ง (Re-forward)</strong>${testTo ? ' <span style=\"color:#b45309;\">(โหมดทดสอบ)</span>' : ''}\n  </div>\n  <div style=\"background-color: #f8f9fa; border: 1px solid #ddd; padding: 12px 16px; margin-bottom: 16px; font-size: 13px;\">\n    <p style=\"margin: 2px 0;\"><strong>ลูกค้า:</strong> ${esc(row.Customer_Name)} (${esc(row.Recipient_Email)})</p>\n    <p style=\"margin: 2px 0;\"><strong>รับเมื่อ:</strong> ${esc(row.Sent_Timestamp)}</p>\n    <p style=\"margin: 2px 0;\"><strong>Subject:</strong> ${esc(subject)}</p>\n    <p style=\"margin: 2px 0; color:#64748b;\">ไฟล์แนบเดิมไม่ได้ถูกส่งซ้ำ</p>\n  </div>\n  ${note}\n  <div>${original}</div>\n</div>`\n  }\n}];"
      },
      "id": "8ec203b3-49a1-4799-88f6-be18d209e9e8",
      "name": "Build Re-forward",
