    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 4.1-4.2 เตรียม Mail Body Template โดยใส่ \"ชื่อ\"\nconst record = $input.item.json;\nconst name = record.resolved_name;\nconst email = record.resolved_email;\nconst dueDate = record.resolved_due_date;\n\n// สร้าง Message-ID เฉพาะสำหรับใช้อ้างอิง\nconst domain = 'automail.internal';\nconst customMessageId = `<n8n-${Date.now()}-${Math.random().toString(36).substring(2, 9)}@${domain}>`;\n\nconst subject = `[แจ้งเตือนครบกำหนด] เรียน ${name} กำหนดการของท่านใกล้ครบกำหนดในอีก 3 เดือน`;\n\nconst htmlBody = `\n<div style=\"font-family: 'Sarabun', Arial, sans-serif; line-height: 1.6; color: #333;\">\n  <h2 style=\"color: #1a73e8;\">แจ้งเตือนกำหนดการ</h2>\n  <p>เรียนคุณ <strong>${name}</strong>,</p>\n  <p>ระบบขอแจ้งเตือนว่ารายการของท่านมีกำหนดครบกำหนดในวันที่: <strong>${dueDate || 'อีก 3 เดือนข้างหน้า'}</strong></p>\n  <p>หากท่านมีข้อสงสัยหรือต้องการดำเนินการต่อ สามารถตอบกลับ (Reply) อีเมลฉบับนี้ได้ทันทีครับ</p>\n  <hr style=\"border: none; border-top: 1px solid #e0e0e0; margin: 20px 0;\" />\n  <p style=\"font-size: 12px; color: #777;\">อีเมลนี้ถูกส่งโดยระบบอัตโนมัติ (Reference ID: ${customMessageId})</p>\n</div>\n`;\n\nconst file1 = $('Download file1').first().binary?.data;\nconst file2 = $('Download file').first().binary?.data1;\nreturn {\n  json: {\n    ...record,\n    mail_subject: subject,\n    mail_html: htmlBody,\n    generated_message_id: customMessageId\n  },\n  // แนบไฟล์กลับเข้ามาใน Item เพื่อส่งต่อให้ Node Send Email\n  binary: {\n    data: file1,\n    data1: file2\n  }\n};"
      },
