    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 4.1-4.2 เติมค่าลงใน Template ที่ดึงจากชีต Templates (ดู node \"Pick Templates\")\n// ตัวแปรที่ใช้ใน template ได้: {{customerName}} {{policyNo}} {{bookingNo}} {{policyExpiry}} {{insuranceType}}\n//                              {{roundLabel}} {{monthsAhead}} {{driveLinks}} {{referenceId}}\nconst record = $input.item.json;\nconst tpl = $('Pick Templates').first().json[record.mail_round]; // R1 | R2\n\n// สร้าง Message-ID เฉพาะสำหรับใช้อ้างอิง\nconst customMessageId = `<n8n-${Date.now()}-${Math.random().toString(36).substring(2, 9)}@automail.internal>`;\n\nconst file1 = $('Download file1').first().binary?.data;\nconst file2 = $('Download file').first().binary?.data1;\n\nconst policyNo = record.policy_no || 'POL-REF';\nconst vars = {\n  customerName: record.resolved_name,\n  policyNo,\n  bookingNo: policyNo,\n  policyExpiry: record.resolved_due_date,\n  insuranceType: record.insurance_type || 'ประกันภัย',\n  roundLabel: record.round_label,\n  monthsAhead: record.months_ahead,\n  driveLinks: [file1, file2].filter(Boolean).map(f => f.fileName).join(', '),\n  referenceId: customMessageId\n};\n\nconst esc = s => s.replace(/[&<>\"]/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[ch]));\nconst fill = (text, escape) => text.replace(/\\{\\{\\s*(\\w+)\\s*\\}\\}/g, (_, k) => {\n  const v = String(vars[k] ?? '');\n  return escape ? esc(v) : v;\n});\n\nreturn {\n  json: {\n    ...record,\n    mail_subject: fill(tpl.subject, false),\n    mail_html: fill(tpl.html, true),\n    generated_message_id: customMessageId,\n    sent_date: new Date().toISOString().split('T')[0]\n  },\n  binary: { data: file1, data1: file2 }\n};"
      },
