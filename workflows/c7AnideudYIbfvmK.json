    {
      "parameters": {
        "jsCode": "// เลือก Template ของรอบ R1/R2 จากชีต Templates (ค้นด้วยคอลัมน์ name; ชื่อกำหนดใน Global Config)\n// หัวคอลัมน์แถวที่ 1 ของชีต: id, name, subject, recipientType, status, description, htmlContent\nconst cfg = $('Global Config').first().json;\nconst rows = $input.all().map(i => i.json);\n\nconst need = ['name', 'subject', 'status', 'htmlContent'];\nconst have = Object.keys(rows[0] || {});\nconst missing = need.filter(k => !have.includes(k));\nif (missing.length) {\n  throw new Error(`ชีต Templates: ไม่พบหัวคอลัมน์ [${missing.join(', ')}] (หัวที่พบ: ${have.join(', ') || 'ไม่มีข้อมูล'})`);\n}\n\nconst pick = round => {\n  const name = cfg[`template_name_${round.toLowerCase()}`];\n  const row = rows.find(r => String(r.name || '').trim() === name);\n  if (!row) throw new Error(`ชีต Templates: ไม่พบ template ชื่อ \"${name}\" (รอบ ${round})`);\n  if ((row.status || 'Active').trim() !== 'Active') throw new Error(`ชีต Templates: template \"${name}\" ไม่ได้เป็น Active`);\n  if (!row.subject || !row.htmlContent) throw new Error(`ชีต Templates: template \"${name}\" ไม่มี subject หรือ htmlContent`);\n  return { subject: row.subject, html: row.htmlContent };\n};\n\nreturn [{ json: { R1: pick('R1'), R2: pick('R2') } }];"
      },
      "id": "d800f6d5-34c5-4390-8bfe-ee4838e60f90",
      "name": "Pick Templates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        512,
        224
      ]
    }
