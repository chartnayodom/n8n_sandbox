    {
      "parameters": {
        "jsCode": "// บันทึก log สถานะสำเร็จเพื่อนำไปรวมส่งรายงานสรุป\nconst template = $('4.1-4.2 Build Mail Template').item.json;\nreturn {\n  json: {\n    is_success: true,\n    name: template.resolved_name,\n    email: template.resolved_email,\n    message_id: template.generated_message_id,\n    reason: 'Success'\n  }\n};"
      },
      "id": "a399ee2a-5655-4e78-ae69-4c33308f2e09",
      "name": "Log Success Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1984,
        112
      ]
    },
    {
      "parameters": {
        "jsCode": "// บันทึก log สถานะไม่สำเร็จเพื่อนำไปรวมส่งรายงานสรุป\nconst template = $('4.1-4.2 Build Mail Template').item.json;\nconst errMsg = $input.item.json.error?.message || 'SMTP Error';\nreturn {\n  json: {\n    is_success: false,\n    name: template.resolved_name,\n    email: template.resolved_email,\n    message_id: template.generated_message_id,\n    reason: errMsg\n  }\n};"
      },
      "id": "410b6773-03d7-418e-a15b-45049e84c3ea",
      "name": "Log Failure Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1984,
        288
      ]
    },
    {
      "parameters": {
        "jsCode": "// 5. สรุปผลการส่ง Auto Email ทั้งหมดในรอบนี้\nlet successLogs = [];\nlet failLogs = [];\n\ntry {\n  successLogs = $('Log Success Result').all().map(i => i.json);\n} catch (e) {}\n\ntry {\n  failLogs = $('Log Failure Result').all().map(i => i.json);\n} catch (e) {}\n\nconst totalSuccess = successLogs.length;\nconst totalFailed = failLogs.length;\nconst totalProcessed = totalSuccess + totalFailed;\n\nconst nowStr = new Date().toLocaleString('th-TH', { timeZone: 'Asia/Bangkok' });\n\nlet htmlReport = `\n<div style=\"font-family: Arial, sans-serif; line-height: 1.5; color: #222;\">\n  <h2>📊 รายงานผลการส่ง Auto Email ประจำรอบ (Service Account)</h2>\n  <p><strong>เวลาประมวลผล:</strong> ${nowStr}</p>\n  <table border=\"1\" cellpadding=\"8\" cellspacing=\"0\" style=\"border-collapse: collapse; width: 100%; max-width: 600px;\">\n    <tr style=\"background-color: #f2f2f2;\"><th>รายการ</th><th>จำนวน</th></tr>\n    <tr><td>ทั้งหมดที่เข้าเงื่อนไข</td><td><strong>${totalProcessed}</strong></td></tr>\n    <tr style=\"color: green;\"><td>ส่งสำเร็จ (4.3.T)</td><td><strong>${totalSuccess}</strong></td></tr>\n    <tr style=\"color: red;\"><td>ไม่สำเร็จ (4.3.F)</td><td><strong>${totalFailed}</strong></td></tr>\n  </table>\n`;\n\nif (totalFailed > 0) {\n  htmlReport += `\n  <h3 style=\"color: red; margin-top: 20px;\">⚠️ รายการที่ไม่สำเร็จ:</h3>\n  <ul>\n    ${failLogs.map(f => `<li><strong>${f.name}</strong> (${f.email}) - เหตุผล: ${f.reason}</li>`).join('')}\n  </ul>\n  `;\n}\n\nhtmlReport += `\n  <hr style=\"margin-top: 30px; border: none; border-top: 1px solid #ccc;\" />\n  <p style=\"font-size: 12px; color: #666;\">รายงานนี้สร้างขึ้นโดยระบบอัตโนมัติ n8n (Google Service Account)</p>\n</div>\n`;\n\nreturn {\n  json: {\n    total_processed: totalProcessed,\n    total_success: totalSuccess,\n    total_failed: totalFailed,\n    report_html: htmlReport,\n    report_subject: `[Auto Mail Report] สรุปผลการส่งอีเมล (${totalSuccess} สำเร็จ, ${totalFailed} ล้มเหลว)`\n  }\n};"
      },
