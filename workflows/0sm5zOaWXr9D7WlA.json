    {
      "parameters": {
        "jsCode": "// 3. กรองข้อมูล: ตรวจสอบ column \"due_date_to\" ว่าหลังจากวันนี้อีก 3 เดือน และยังไม่เคยส่งสำเร็จ\nconst results = [];\nconst today = new Date();\n\nconst targetMonths = 3;\nconst minTargetDate = new Date();\nminTargetDate.setMonth(today.getMonth() + targetMonths);\nminTargetDate.setDate(minTargetDate.getDate() - 15); // ช่วงเริ่มต้น window (-15 วัน)\n\nfor (const item of $input.all()) {\n  const row = item.json;\n  \n  const name = row['ชื่อ'] || row['name'] || row['Name'] || '';\n  const email = row['email'] || row['Email'] || row['อีเมล'] || '';\n  const status = row['status'] || row['Status'] || row['สถานะ'] || '';\n  const dueDateRaw = row['due_date_to'] || row['dueDate'] || '';\n  \n  // ข้ามรายการที่ไม่มี email หรือเคยส่งสำเร็จไปแล้ว\n  if (!email || status === 'สำเร็จ' || status === 'Sent') {\n    continue;\n  }\n  \n  let isMatchedDate = true;\n  if (dueDateRaw) {\n    const dueDate = new Date(dueDateRaw);\n    if (!isNaN(dueDate.getTime())) {\n      isMatchedDate = dueDate >= minTargetDate;\n    }\n  }\n  \n  if (isMatchedDate) {\n    results.push({\n      json: {\n        ...row,\n        resolved_name: name || 'คุณลูกค้า',\n        resolved_email: email,\n        resolved_due_date: dueDateRaw\n      }\n    });\n  }\n}\n\nreturn results;"
      },
