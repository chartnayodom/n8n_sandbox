  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "e4f8d21b-1001-4b1a-9876-000000000001",
      "name": "Schedule Trigger (Every 1 Hour)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {},
      "id": "e4f8d21b-1001-4b1a-9876-000000000002",
      "name": "Manual Trigger (Test Now)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        220,
        140
      ]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Sheet1",
          "mode": "name"
        },
        "options": {}
      },
      "id": "e4f8d21b-1001-4b1a-9876-000000000003",
      "name": "Google Sheets - Read Unsent Rows",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        460,
        220
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.Status }}",
              "rightValue": "Sent",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            },
            {
              "id": "c2",
              "leftValue": "={{ $json.Email }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "isNotEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e4f8d21b-1001-4b1a-9876-000000000004",
      "name": "Filter: Status != Sent & Email Not Empty",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        700,
        220
      ]
    },
    {
      "parameters": {
        "fromEmail": "sender@yourdomain.com",
        "toEmail": "={{ $json.Email }}",
        "subject": "={{ $json.Subject || 'Important Update regarding your request' }}",
        "html": "=<p>Dear {{ $json.Name || 'Customer' }},</p><p>{{ $json.Message || 'Thank you for connecting with us.' }}</p><p>Best regards,<br>Automated Mail Service</p>",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "e4f8d21b-1001-4b1a-9876-000000000005",
      "name": "Send Email via SMTP",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        940,
        200
      ],
      "credentials": {
        "smtp": {
          "id": "",
          "name": "SMTP account"
        }
      }
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "value": "",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Sheet1",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Status": "Sent",
            "SentAt": "={{ $now.toISO() }}",
            "MessageId": "={{ $json.messageId || 'Sent-' + $now.toMillis() }}"
          },
          "matchingColumns": [
            "Email"
          ]
        },
        "options": {}
      },
      "id": "e4f8d21b-1001-4b1a-9876-000000000006",
      "name": "Google Sheets - Update Status to Sent",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1180,
        200
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": "Google Sheets account"
        }
      }
    }
