    {
      "parameters": {
        "jsCode": "// แยกอีเมลขาเข้าตาม Flow 2:\n//   ผู้ส่งอยู่ใน Master_Data     → forward ไปบริษัทประกัน (ถ้าปิด Auto Forward = Pending, ถ้ายังไม่ตั้ง insurance_email = Failed)\n//   ผู้ส่งไม่อยู่ใน Master_Data  → Needs Review ให้เจ้าหน้าที่ตรวจสอบ (นิยามเดียวของ Needs Review)\n//   ผู้ส่งอยู่ในรายการละเว้น / เมลที่เคยประมวลผลแล้ว → ข้าม\n// ข้อมูลที่ใช้: Global Config (ค่าคงที่), config (insurance_email, auto_forward), Master_Data (ผู้ส่งที่อนุญาต), Email_Logs (กันประมวลผลซ้ำ + จับ Reply)\nconst cfg = $('Global Config').first().json;\nconst csv = s => String(s || '').split(',').map(x => x.trim().toLowerCase()).filter(Boolean);\nconst clean = s => String(s || '').replace(/[<>]/g, '').trim();\nconst esc = s => String(s ?? '').replace(/[&<>\"]/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[ch]));\n\n// --- config sheet (Category = SYSTEM) ---\nconst sys = {};\nfor (const i of $('Read config').all()) {\n  const r = i.json;\n  if (String(r.Category || '').trim().toUpperCase() === 'SYSTEM') sys[String(r.Key || '').trim()] = String(r.Value || '').trim();\n}\nconst insuranceEmail = sys.insurance_email || '';\nconst autoForward = String(sys.auto_forward || 'TRUE').trim().toUpperCase() !== 'FALSE';\nconst testTo = String(cfg.test_forward_email || '').trim(); // ไม่ว่าง = โหมดทดสอบ forward ไปอีเมลนี้แทนบริษัทประกัน\nconst forwardTo = testTo || insuranceEmail;\n\nconst ignoreSenders = new Set(csv(cfg.ignore_senders));\nif (insuranceEmail) ignoreSenders.add(insuranceEmail.toLowerCase());\n\n// --- Master_Data / Email_Logs ---\nconst master = new Map();\nfor (const i of $('Read Master_Data').all()) {\n  const e = String(i.json.Email || '').trim().toLowerCase();\n  if (e) master.set(e, i.json);\n}\nconst logged = new Set();\nfor (const i of $('Read Email_Logs').all()) {\n  const id = clean(i.json.Message_ID);\n  if (id) logged.add(id);\n}\n\nconst results = [];\nfor (const item of $('Listener: IMAP Email Trigger').all()) {\n  const mail = item.json;\n  const from = mail.from?.value?.[0] || {};\n  const addr = String(from.address || '').trim().toLowerCase();\n  const subject = String(mail.subject || '').trim();\n  const messageId = clean(mail.messageId || mail.headers?.['message-id']);\n\n  // Reply ของอีเมลที่ระบบเคยส่ง (In-Reply-To / References ตรงกับ Message_ID ใน Email_Logs)\n  const refs = [].concat(mail.inReplyTo || mail.headers?.['in-reply-to'] || [], mail.references || mail.headers?.references || [])\n    .join(' ').split(/\\s+/).map(clean).filter(Boolean);\n  const isReplyToOurs = refs.some(r => logged.has(r));\n  const lowerSubject = subject.toLowerCase();\n\n  // route: ignore | forward | review | hold   (hold = ผู้ส่งอยู่ใน Master Data แต่ส่งต่อไม่ได้ในตอนนี้)\n  let route = 'ignore';\n  let reason = '';\n  let logStatus = '';\n  const row = master.get(addr);\n\n  if (!addr) reason = 'ไม่มีอีเมลผู้ส่ง';\n  else if (ignoreSenders.has(addr)) reason = 'ผู้ส่งอยู่ในรายการละเว้น';\n  else if (messageId && logged.has(messageId)) reason = 'ประมวลผลแล้ว';\n  else if (row) {\n    if (!autoForward) { route = 'hold'; logStatus = 'Pending'; reason = 'ปิด Auto Forward ในหน้าตั้งค่าระบบ รอเจ้าหน้าที่ส่งต่อ'; }\n    else if (!forwardTo) { route = 'hold'; logStatus = 'Failed'; reason = 'ยังไม่ได้ตั้งค่าอีเมลบริษัทประกัน (config: insurance_email)'; }\n    else { route = 'forward'; reason = 'พบอีเมลผู้ส่งใน Master Data'; }\n  } else {\n    route = 'review'; logStatus = 'Needs Review';\n    reason = isReplyToOurs ? 'ตอบกลับอีเมลที่ระบบส่ง แต่ไม่พบอีเมลผู้ส่งใน Master Data' : 'ไม่พบอีเมลผู้ส่งใน Master Data';\n  }\n  if (route === 'ignore') continue;\n\n  const binary = item.binary || {};\n  const attachNames = Object.keys(binary);\n  const bodyHtml = mail.html || `<pre style=\"white-space: pre-wrap; font-family: inherit;\">${esc(mail.text || '(ไม่มีข้อความ)')}</pre>`;\n  const customer = row\n    ? `<p style=\"margin: 2px 0;\"><strong>ลูกค้า:</strong> ${esc(row.Customer_Name)} (${esc(row.Insurance_Type || '-')})</p>\n       <p style=\"margin: 2px 0;\"><strong>เลขที่กรมธรรม์:</strong> ${esc(row.Policy_No || '-')} &nbsp; <strong>วันหมดอายุ:</strong> ${esc(row.Expiry_Date || '-')}</p>`\n    : '';\n  const forwardHtml = `\n<div style=\"font-family: Arial, sans-serif; font-size: 14px; line-height: 1.6; color: #222;\">\n  <div style=\"background-color: #e8f0fe; border-left: 4px solid #1a73e8; padding: 12px 16px; margin-bottom: 16px;\">\n    <strong>[AutoMail] ส่งต่ออัตโนมัติ</strong>${testTo ? ' <span style=\"color:#b45309;\">(โหมดทดสอบ)</span>' : ''}<br/>\n    <span style=\"font-size: 12px;\">${esc(reason)}</span>\n  </div>\n  <div style=\"background-color: #f8f9fa; border: 1px solid #ddd; padding: 12px 16px; margin-bottom: 16px; font-size: 13px;\">\n    ${customer}\n    <p style=\"margin: 2px 0;\"><strong>From:</strong> ${esc(mail.from?.text || addr)}</p>\n    <p style=\"margin: 2px 0;\"><strong>Date:</strong> ${esc(mail.date || '')}</p>\n    <p style=\"margin: 2px 0;\"><strong>Subject:</strong> ${esc(subject)}</p>\n    ${attachNames.length ? `<p style=\"margin: 2px 0;\"><strong>ไฟล์แนบ:</strong> ${attachNames.length} ไฟล์</p>` : ''}\n  </div>\n  <div>${bodyHtml}</div>\n</div>`;\n\n  results.push({\n    json: {\n      route,\n      reason,\n      log_status: logStatus,\n      log_round: route === 'review' ? 'Needs Review (อีเมลขาเข้า)' : 'อีเมลขาเข้า (ยังไม่ได้ส่งต่อ)',\n      test_mode: Boolean(testTo),\n      from_email: addr,\n      from_name: from.name || '',\n      subject,\n      message_id: messageId,\n      customer_id: row?.ID || '',\n      customer_name: row?.Customer_Name || from.name || addr,\n      forward_to: forwardTo,\n      forward_subject: (testTo ? '[TEST] ' : '') + (lowerSubject.startsWith('fwd:') ? subject : `Fwd: ${subject}`),\n      forward_html: forwardHtml,\n      attach_names: attachNames.join(', '),\n      log_id: `LOG-${Date.now()}-${Math.random().toString(36).slice(2, 7)}`,\n      // เก็บเนื้อหาไว้ใน Email_Logs (คอลัมน์ Original_Body) เพื่อให้ปุ่ม Re-forward ส่งซ้ำได้ (จำกัดความยาวของเซลล์ Google Sheets)\n      original_body: bodyHtml.slice(0, 40000),\n      review_alert_email: String(cfg.review_alert_email || '').trim()\n    },\n    binary\n  });\n}\nreturn results;"
      },
      "id": "dc02606c-e7eb-4782-9cd0-185ff35554c7",
