# .env ที่โฟลเดอร์รากสำหรับ VPS (automail.myaiaplan.com: Caddy บน host → 127.0.0.1:5000)
# ใช้: cp deploy/vps/.env.example .env แล้วใส่ N8N_ENCRYPTION_KEY
# ค่าของ service web (Google Sheets / IMAP) อยู่อีกไฟล์: sheets-app/server/.env (template: sheets-app/server/.env.example)

N8N_PORT=5678
N8N_PROTOCOL=http
N8N_HOST=localhost
GENERIC_TIMEZONE=Asia/Bangkok
TZ=Asia/Bangkok

# openssl rand -hex 32 — ห้ามเปลี่ยนหลังสร้าง credential ใน n8n แล้ว (ถอดรหัสไม่ได้)
N8N_ENCRYPTION_KEY=

# n8n ไม่ได้เปิดผ่านโดเมน: webhook re-forward ถูกเรียกจาก container web ภายใน network ของ compose
# (docker-compose.yml ตั้ง N8N_WEBHOOK_URL=http://n8n:5678/webhook/re-forward ให้ service web แล้ว ทับค่าในชีต config)
WEBHOOK_URL=http://localhost:5678/

# พอร์ตฝั่ง host ของเว็บ (ผูก 127.0.0.1 ใน docker-compose.yml) ต้องตรงกับ reverse_proxy ใน deploy/vps/automail.caddy
WEB_PORT=5000
